{{- $standalone := site.Params.standaloneSection | default "notes" -}}
[{{ range $i, $page := where site.RegularPages "Type" "not in" (slice "page" "json") }}
  {{- if $i }},{{ end }}
  {{- $coll := $page.Section -}}
  {{- $collTitle := "" -}}
  {{- if or (eq $coll $standalone) (eq $coll "search") -}}
    {{- $coll = "" -}}
  {{- else -}}
    {{- with site.GetPage (printf "/%s" $coll) -}}
      {{- $collTitle = .Title -}}
    {{- else -}}
      {{- $collTitle = $coll -}}
    {{- end -}}
  {{- end -}}
  {
    "title": {{ $page.Title | htmlUnescape | jsonify }},
    "url": {{ $page.RelPermalink | jsonify }},
    "collection": {{ $coll | jsonify }},
    "collectionTitle": {{ $collTitle | jsonify }},
    "tags": {{ $page.Params.tags | default (slice) | jsonify }},
    "date": {{ $page.Date.Format "2006-01-02" | jsonify }},
    "summary": {{ $page.Summary | plainify | htmlUnescape | jsonify }},
    "content": {{ $page.Plain | htmlUnescape | jsonify }}
  }
{{- end }}]
